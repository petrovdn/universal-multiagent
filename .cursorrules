# ✅ ПРАВИЛЬНО: WebSocket для real-time
# src/api/websocket_manager.py
async for chunk in graph.astream(state, stream_mode="messages"):
    await websocket.send_json({
        "type": "token",
        "content": chunk
    })

# stream_mode варианты:
