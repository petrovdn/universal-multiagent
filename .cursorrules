## ⚛️ Frontend: React + TypeScript + Zustand

### State Management — Zustand (НЕ Context+useReducer!)
```typescript
// ✅ ПРАВИЛЬНО: Zustand с persist
import { create } from 'zustand'
import { persist } from 'zustand/middleware'

interface ChatState {
  messages: Message[]
  isConnected: boolean
  isAgentTyping: boolean
  workflows: Record<string, Workflow>
  
  addMessage: (msg: Message) => void
  setConnectionStatus: (connected: boolean) => void
}

export const useChatStore = create<ChatState>()(
  persist(
    (set, get) => ({
      messages: [],
      isConnected: false,
      isAgentTyping: false,
      workflows: {},
      
      addMessage: (msg) => set((state) => ({
        messages: [...state.messages, msg]
      })),
      
      setConnectionStatus: (connected) => set({ isConnected: connected }),
    }),
    {
      name: 'chat-storage',
      partialize: (state) => ({
        // Не персистим временные данные
        currentSession: state.currentSession,
      }),
    }
  )
)

// ❌ НЕПРАВИЛЬНО: Context + useReducer для глобального state
import { createContext, useReducer } from 'react'  // НЕ для state management
```

### Типобезопасность
```typescript
// ✅ ПРАВИЛЬНО: Строгие типы
interface Message {
  role: 'user' | 'assistant' | 'system'
  content: string
  timestamp: string
  metadata?: Record<string, unknown>  // unknown вместо any где возможно
}

interface WorkflowStep {
  stepNumber: number
  title: string
  status: 'pending' | 'in_progress' | 'completed'
  thinking: string
  response: string
}

// ❌ НЕПРАВИЛЬНО
interface Message {
  role: string       // Слишком широко
  content: any       // Избегайте any
  metadata?: any     // Используйте Record<string, unknown>
}
```

### WebSocket клиент
```typescript
// ✅ ПРАВИЛЬНО: WebSocket для стриминга
const connectWebSocket = (sessionId: string) => {
  const ws = new WebSocket(`ws://localhost:8000/ws/${sessionId}`)
  
  ws.onmessage = (event) => {
    const data = JSON.parse(event.data)
    
    switch (data.type) {
      case 'token':
        // Стриминг токенов
        updateStreamingMessage(data.content)
        break
      case 'tool_call':
        // Tool вызов
        addToolCall(data)
        break
      case 'message_complete':
        // Сообщение завершено
        completeMessage(data)
        break
    }
  }
  
  return ws
}

// ❌ НЕПРАВИЛЬНО: SSE или polling
const eventSource = new EventSource('/stream')  // НЕ ИСПОЛЬЗУЕМ
```

